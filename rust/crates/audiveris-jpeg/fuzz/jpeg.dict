# JPEG markers, so the fuzzer can build structurally valid segments instead of
# only mutating bytes inside existing ones.
soi="\xff\xd8"
eoi="\xff\xd9"
sof0="\xff\xc0"
sof1="\xff\xc1"
sof2="\xff\xc2"
sof3="\xff\xc3"
sof9="\xff\xc9"
sof10="\xff\xca"
dht="\xff\xc4"
dqt="\xff\xdb"
dri="\xff\xdd"
sos="\xff\xda"
app0="\xff\xe0"
app14="\xff\xee"
com="\xff\xfe"
rst0="\xff\xd0"
rst7="\xff\xd7"
stuff="\xff\x00"
jfif="JFIF\x00"
adobe="Adobe"
